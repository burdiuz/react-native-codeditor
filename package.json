{
  "name": "react-native-codeditor",
  "version": "0.1.0",
  "description": "eferf",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-codeditor-example",
    "clean": "del-cli lib",
    "copy-assets": "node scripts/copy-assets.js",
    "prepare": "node scripts/copy-assets.js && bob build",
    "typecheck": "tsc"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burdiuz/react-native-codeditor.git"
  },
  "author": "Oleg Galaburda <burdiuz@gmail.com> (https://github.com/burdiuz)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/burdiuz/react-native-codeditor/issues"
  },
  "homepage": "https://github.com/burdiuz/react-native-codeditor#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@actualwave/js-codemirror-package": "github:burdiuz/js-codemirror-package",
    "@react-native/assets-registry": "^0.85.3",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/js-polyfills": "^0.85.3",
    "@react-native/metro-config": "^0.85.3",
    "@react-native/virtualized-lists": "^0.83.6",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-builder-bob": "^0.41.0",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@actualwave/webview-interface": "^0.0.1"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-webview": ">=11.0.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [],
    "version": "0.62.0"
  }
}
